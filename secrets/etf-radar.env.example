# 서버가 읽는 변수 목록(값 없음). 실제 값이 든 etf-radar.env 는 git 에 올리지 않는다(.gitignore).
# 전부 선택 사항: 비워 두어도 서버는 동작한다.
#
# 실제 값은 이 폴더의 etf-radar.env 에 직접 둔다.

# 핸드폰 알림: 디스코드 채널 설정 → 연동 → 웹후크 → 새 웹후크 → URL 복사
# 이 주소는 비밀값이다. 채팅·노션·git 에 붙여넣지 말 것
DISCORD_WEBHOOK_URL=

# 화면 비밀번호. 비우면 로그인 없이 열린다 — 내부망에서만 쓸 때만 비울 것
APP_PASSWORD=

# 알림에 넣을 화면 주소 (예: http://192.168.0.20:3200)
PUBLIC_URL=
